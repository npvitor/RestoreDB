# Normaliza finais de linha (LF no repositório; o Git converte no checkout conforme a plataforma).
* text=auto

# Código e projetos
*.cs      text diff=csharp
*.xaml    text
*.csproj  text
*.slnx    text
*.pubxml  text
*.props   text
*.targets text
*.md      text
*.sql     text
*.json    text
*.yml     text

# Scripts do Windows mantêm CRLF
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binários
*.ico     binary
*.png     binary
*.jpg     binary
*.gif     binary
*.pdf     binary
*.bak     binary
*.mdf     binary
*.ldf     binary
