<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================= TEMA ESCURO ================= -->
    <!-- Chrome / superfícies -->
    <SolidColorBrush x:Key="WindowBackBrush" Color="#1B1F24" />
    <SolidColorBrush x:Key="CardBrush" Color="#252A31" />
    <SolidColorBrush x:Key="LineBrush" Color="#39424D" />
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#2B313A" />
    <SolidColorBrush x:Key="LogHeaderBackBrush" Color="#2B313A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2C4456" />

    <!-- Texto -->
    <SolidColorBrush x:Key="TextBrush" Color="#E6EAEE" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9BA8B5" />

    <!-- Marca / ação primária -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2E90CC" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#CFE6F5" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#313945" />
    <SolidColorBrush x:Key="DisabledButtonBrush" Color="#4A535E" />

    <!-- Perigo -->
    <SolidColorBrush x:Key="DangerBrush" Color="#D2453F" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#F2ADA9" />
    <SolidColorBrush x:Key="DangerPanelBackBrush" Color="#45211F" />

    <!-- Estados semânticos (painéis) -->
    <SolidColorBrush x:Key="OkBackBrush" Color="#16331F" />
    <SolidColorBrush x:Key="OkForeBrush" Color="#7FD69A" />
    <SolidColorBrush x:Key="WarnBackBrush" Color="#3A2E12" />
    <SolidColorBrush x:Key="WarnForeBrush" Color="#E8C07A" />
    <SolidColorBrush x:Key="WarnLineBrush" Color="#B58A3A" />
    <SolidColorBrush x:Key="ProblemBackBrush" Color="#3A1E1E" />
    <SolidColorBrush x:Key="ProblemForeBrush" Color="#F2ADA9" />

    <!-- Cores do registro de operações (por nível) -->
    <SolidColorBrush x:Key="LogInfoBrush" Color="#C9D2DB" />
    <SolidColorBrush x:Key="LogCommandBrush" Color="#5BB2E8" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#6FCF97" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#E0B25A" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#E57373" />
</ResourceDictionary>
