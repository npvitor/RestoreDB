<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ================= TEMA CLARO ================= -->
    <!-- Chrome / superfícies -->
    <SolidColorBrush x:Key="WindowBackBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="LineBrush" Color="#D7DEE5" />
    <SolidColorBrush x:Key="GridAltRowBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="LogHeaderBackBrush" Color="#EEF3F7" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#D7E8F4" />

    <!-- Texto -->
    <SolidColorBrush x:Key="TextBrush" Color="#1B2A36" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#5A6B7B" />

    <!-- Marca / ação primária -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0B5A8A" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#084466" />
    <!-- Texto sobre PrimaryBrush (números dos passos). -->
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="#EAF2F8" />
    <SolidColorBrush x:Key="DisabledButtonBrush" Color="#AAB7C2" />

    <!-- Perigo -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C01B1B" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="#9A1414" />
    <SolidColorBrush x:Key="DangerPanelBackBrush" Color="#F7DCDC" />

    <!-- Estados semânticos (painéis) -->
    <SolidColorBrush x:Key="OkBackBrush" Color="#E7F3EA" />
    <SolidColorBrush x:Key="OkForeBrush" Color="#1B7A2F" />
    <SolidColorBrush x:Key="WarnBackBrush" Color="#FFF6E5" />
    <SolidColorBrush x:Key="WarnForeBrush" Color="#8A5200" />
    <SolidColorBrush x:Key="WarnLineBrush" Color="#B56A00" />
    <SolidColorBrush x:Key="ProblemBackBrush" Color="#FCEAEA" />
    <SolidColorBrush x:Key="ProblemForeBrush" Color="#9A1414" />

    <!-- Cores do registro de operações (por nível) -->
    <SolidColorBrush x:Key="LogInfoBrush" Color="#333333" />
    <SolidColorBrush x:Key="LogCommandBrush" Color="#0B5A8A" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#1B7A2F" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#B56A00" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#C01B1B" />
</ResourceDictionary>
