<Window x:Class="RestoreDB.App.Views.ConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestoreDB — Conexão (Módulo de Faturamento)"
        Icon="/Assets/app.ico"
        SizeToContent="Height" Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource WindowBackBrush}">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="RestoreDB" Style="{StaticResource HeaderText}" FontSize="26" />
            <TextBlock Text="Diagnóstico e Reparo de Bancos SQL Server"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="14" Margin="0,2,0,0" />
            <TextBlock Text="Módulo de Faturamento"
                       Foreground="{DynamicResource PrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Formulário -->
        <Border Grid.Row="1" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="6" Padding="22">
            <StackPanel>
                <TextBlock Text="SERVIDOR" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="ServerBox" Text="localhost"
                         ToolTip="Ex.: localhost, .\SQLEXPRESS, 192.168.0.10,1433" />

                <CheckBox x:Name="WindowsAuthCheck" Margin="0,14,0,0" Content="Usar autenticação do Windows (Integrated Security)"
                          Checked="WindowsAuthCheck_Changed" Unchecked="WindowsAuthCheck_Changed" />

                <TextBlock x:Name="UserLabel" Text="USUÁRIO" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <TextBox x:Name="UserBox" Text="sa" />

                <TextBlock x:Name="PasswordLabel" Text="SENHA" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                <PasswordBox x:Name="PasswordBox" />

                <Button x:Name="ConnectButton" Content="Conectar" Style="{StaticResource FlatButton}"
                        Margin="0,22,0,0" Height="42" Click="ConnectButton_Click" IsDefault="True" />

                <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                             Visibility="Collapsed" Foreground="{DynamicResource PrimaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Mensagem de erro -->
        <Border Grid.Row="2" x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,14,0,0"
                Background="{DynamicResource ProblemBackBrush}" BorderBrush="{DynamicResource DangerBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14">
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerDarkBrush}" TextWrapping="Wrap" />
        </Border>

        <!-- Rodapé -->
        <TextBlock Grid.Row="3" VerticalAlignment="Bottom" Margin="0,10,0,0"
                   Text="A conexão usa o banco master e parâmetros pré-definidos (timeout, criptografia, etc.). Compatível com SQL Server 2008 R2."
                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" HorizontalAlignment="Center" />
    </Grid>
</Window>
