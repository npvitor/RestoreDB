<Window x:Class="RestoreDB.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RestoreDB — Diagnóstico e Reparo (Módulo de Faturamento)"
        Icon="/Assets/app.ico"
        Height="780" Width="1360" MinHeight="620" MinWidth="1080"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource WindowBackBrush}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="220" />
            <RowDefinition Height="6" />
            <RowDefinition Height="230" MinHeight="120" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Barra superior ===== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Bancos de dados do servidor" Style="{StaticResource HeaderText}" FontSize="17" />
                    <TextBlock x:Name="ServerInfoText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="ThemeToggleButton" Content="🌙  Tema escuro" Style="{StaticResource ThemeToggle}"
                                  Margin="0,0,8,0" Click="ThemeToggleButton_Click" />
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource DangerButton}"
                            Click="CancelButton_Click" Margin="0,0,8,0" IsEnabled="False" />
                    <Button x:Name="AttachButton" Content="Anexar .mdf" Style="{StaticResource SecondaryButton}"
                            Click="AttachButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="RefreshButton" Content="Atualizar lista" Style="{StaticResource SecondaryButton}"
                            Click="RefreshButton_Click" Margin="0,0,8,0" />
                    <Button x:Name="ReconnectButton" Content="Trocar conexão" Style="{StaticResource SecondaryButton}"
                            Click="ReconnectButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Conteúdo: lista (master) + painel de ações (detalhe, dominante) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Lista compacta e redimensionável; o painel de ações recebe o maior espaço. -->
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" MinWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- Lista de bancos -->
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="6" Margin="0">
                <DataGrid x:Name="DatabasesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent"
                          Foreground="{DynamicResource TextBrush}"
                          HorizontalGridLinesBrush="{DynamicResource LineBrush}"
                          AlternatingRowBackground="{DynamicResource GridAltRowBrush}"
                          SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False"
                          SelectionChanged="DatabasesGrid_SelectionChanged"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsProblematic}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ProblemBackBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource ProblemForeBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Banco" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding StateDesc}" Width="Auto" MinWidth="96" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Divisor ajustável entre a lista e o painel de ações -->
            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <!-- Painel de ações (diagnóstico, reparo e restauração) — área principal -->
            <Border Grid.Column="2" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="22,18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel MaxWidth="1400" HorizontalAlignment="Left">
                        <TextBlock Text="Diagnóstico, reparo e restauração" Style="{StaticResource HeaderText}" FontSize="17" Margin="0,0,0,4" />
                        <TextBlock Text="Selecione um banco à esquerda, diagnostique e siga a ação recomendada. Operações destrutivas sempre pedem confirmação."
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <!-- Sem seleção -->
                        <TextBlock x:Name="NoSelectionText"
                                   Text="Selecione um banco na lista para ver os detalhes."
                                   Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />

                        <!-- Detalhes: 2 colunas — diagnóstico à esquerda, resolução à direita (aproveita widescreen) -->
                        <Grid x:Name="DetailsPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Coluna esquerda: estado + diagnóstico (Passo 1) + resultado -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <TextBlock x:Name="DbNameText" FontSize="18" FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryDarkBrush}" TextWrapping="Wrap" />

                            <TextBlock Text="ESTADO ATUAL" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                            <Border x:Name="StateBadge" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left"
                                    Background="{DynamicResource OkBackBrush}">
                                <TextBlock x:Name="StateText" FontWeight="SemiBold" Foreground="{DynamicResource OkForeBrush}" />
                            </Border>
                            <TextBlock x:Name="StateFriendlyText" Foreground="{DynamicResource MutedTextBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,0" />

                            <TextBlock Text="AÇÃO RECOMENDADA" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                            <TextBlock x:Name="RecommendedActionText" TextWrapping="Wrap" />

                            <!-- Banco saudável -->
                            <Border x:Name="HealthyPanel" Visibility="Collapsed" Margin="0,16,0,0"
                                    Background="{DynamicResource OkBackBrush}" BorderBrush="{DynamicResource OkForeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock Text="Este banco está ONLINE. O estado aparenta saúde, mas pode haver corrupção que só uma verificação completa revela — use 'Diagnosticar' abaixo para uma checagem profunda (CHECKDB + CHECKCONSTRAINTS + CHECKCATALOG)."
                                           Foreground="{DynamicResource OkForeBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Banco de sistema -->
                            <Border x:Name="SystemDbPanel" Visibility="Collapsed" Margin="0,16,0,0"
                                    Background="{DynamicResource WarnBackBrush}" BorderBrush="{DynamicResource WarnLineBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Banco de sistema: o reparo automático destrutivo não é permitido por esta ferramenta. Acione o DBA/suporte."
                                               Foreground="{DynamicResource WarnForeBrush}" TextWrapping="Wrap" />
                                    <Button x:Name="RunbookButton" Content="Ver procedimento manual recomendado"
                                            Style="{StaticResource SecondaryButton}" Height="38" Margin="0,10,0,0"
                                            Click="RunbookButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Diagnóstico (somente leitura) — passo 1, ação principal -->
                            <StackPanel x:Name="DiagnosePanel" Visibility="Collapsed" Margin="0,18,0,0">
                                <TextBlock Text="PASSO 1 — DIAGNOSTICAR" Style="{StaticResource FieldLabel}" />
                                <Button x:Name="DiagnoseButton" Content="🔍  Diagnosticar (sem alterar o banco)"
                                        Style="{StaticResource FlatButton}" Height="48" FontSize="15" Click="DiagnoseButton_Click" />
                                <CheckBox x:Name="PhysicalOnlyCheck" Content="Verificação rápida (PHYSICAL_ONLY) — para bancos muito grandes"
                                          Margin="0,8,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="Verificação completa SEM alterar nada: DBCC CHECKDB com DATA_PURITY (consistência física e valores inválidos), CHECKCONSTRAINTS (chaves estrangeiras/CHECK), CHECKCATALOG (metadados), páginas suspeitas e log de erros. Detecta corrupção mesmo em bancos que parecem saudáveis (ONLINE). Se houver corrupção física, as checagens lógicas são adiadas até o reparo."
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />

                                <!-- Verificações avançadas (dirigidas) -->
                                <Expander x:Name="AdvancedChecksExpander" Header="Verificações avançadas" Margin="0,10,0,0"
                                          Foreground="{DynamicResource MutedTextBrush}">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Verificação dirigida de UMA tabela (DBCC CHECKTABLE) — mais rápida que o CHECKDB completo."
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        <ComboBox x:Name="CheckTableCombo" Height="28" Margin="0,6,0,0" IsEditable="True"
                                                  DropDownOpened="CheckTableCombo_DropDownOpened" />
                                        <Button x:Name="CheckTableButton" Content="Verificar tabela (CHECKTABLE)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="CheckTableButton_Click" />
                                        <Button x:Name="ReseedButton" Content="Reajustar identidades (CHECKIDENT RESEED)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="ReseedButton_Click" />
                                        <TextBlock Text="O reajuste de identidade é útil após remoção de linhas (reparo com perda / salvamento)."
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Expander>

                                <!-- Manutenção e ferramentas (preventivo + forense + agendamento) -->
                                <Expander x:Name="ToolsExpander" Header="Manutenção e ferramentas" Margin="0,8,0,0"
                                          Foreground="{DynamicResource MutedTextBrush}">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Text="Manutenção preventiva: desfragmenta índices (REORGANIZE/REBUILD) e atualiza estatísticas."
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" />
                                        <Button x:Name="MaintainButton" Content="Otimizar índices e estatísticas"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="MaintainButton_Click" />
                                        <Button x:Name="ScheduleButton" Content="Configurar verificação agendada (gerar comando)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="ScheduleButton_Click" />

                                        <TextBlock Text="Recuperar de exclusão acidental: lista DELETE/DROP/TRUNCATE recentes no log e restaura até logo antes."
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                        <Button x:Name="ForensicButton" Content="Procurar exclusões recentes no log"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="ForensicButton_Click" />
                                        <ListBox x:Name="ForensicList" Height="92" Margin="0,6,0,0" Visibility="Collapsed"
                                                 Background="{DynamicResource CardBrush}" DisplayMemberPath="Display"
                                                 BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" />
                                        <Button x:Name="ForensicRestoreButton" Content="Restaurar até ANTES da transação selecionada"
                                                Style="{StaticResource DangerButton}" Height="38" Margin="0,6,0,0" Visibility="Collapsed"
                                                Click="ForensicRestoreButton_Click" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Resultado do diagnóstico (= ação recomendada destacada) -->
                            <Border x:Name="DiagnosisResultPanel" Visibility="Collapsed" Margin="0,12,0,0"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="RESULTADO DO DIAGNÓSTICO" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="DiagnosisSummaryText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    <TextBlock x:Name="RecoActionNameText" FontWeight="Bold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock x:Name="DiagnosisRecoText" TextWrapping="Wrap" Margin="0,6,0,0" />

                                    <!-- Novidades desde a última verificação (B5) -->
                                    <Border x:Name="NoveltyPanel" Visibility="Collapsed" Margin="0,10,0,0"
                                            Background="{DynamicResource WarnBackBrush}" BorderBrush="{DynamicResource WarnLineBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="⚠ NOVO desde a última verificação" FontWeight="Bold"
                                                       Foreground="{DynamicResource WarnForeBrush}" FontSize="11" />
                                            <ItemsControl x:Name="NoveltyList" Margin="0,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                                                   Foreground="{DynamicResource WarnForeBrush}" Margin="0,1,0,0" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Política de backup (B3) e saúde lógica (B4) -->
                                    <TextBlock x:Name="PolicyHeader" Text="POLÍTICA DE BACKUP / SAÚDE LÓGICA" Style="{StaticResource FieldLabel}"
                                               Margin="0,12,0,0" Visibility="Collapsed" />
                                    <ItemsControl x:Name="FindingsList" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" FontSize="11" Margin="0,1,0,0"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- Aviso de topologia (espelhamento/AG/log shipping/replicação) -->
                            <Border x:Name="TopologyWarnPanel" Visibility="Collapsed" Margin="0,12,0,0"
                                    Background="{DynamicResource WarnBackBrush}" BorderBrush="{DynamicResource WarnLineBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="⚠ TOPOLOGIA DE ALTA DISPONIBILIDADE / REPLICAÇÃO"
                                               FontWeight="Bold" Foreground="{DynamicResource WarnForeBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="TopologyWarnText" Foreground="{DynamicResource WarnForeBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            </StackPanel>

                            <!-- Coluna direita: como resolver (Passo 2) — reparo / restauração -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="24,0,0,0">
                            <!-- Cabeçalho das opções de reparo (aparece só após o diagnóstico) -->
                            <TextBlock x:Name="RepairOptionsTitle" Visibility="Collapsed" Text="PASSO 2 — COMO RESOLVER"
                                       Style="{StaticResource FieldLabel}" Margin="0,0,0,0" />

                            <!-- [PRIMÁRIO p/ corrupção só de índice] Reparo SEM perda: reconstrução de índices -->
                            <Border x:Name="IndexRepairPanel" Visibility="Collapsed" Margin="0,8,0,0"
                                    Background="{DynamicResource OkBackBrush}" BorderBrush="{DynamicResource OkForeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="✔ REPARO SEM PERDA DE DADOS DISPONÍVEL" FontWeight="Bold"
                                               Foreground="{DynamicResource OkForeBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="A corrupção está restrita a índices não-clusterizados, que podem ser reconstruídos sem perder dados."
                                               Foreground="{DynamicResource OkForeBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <Button x:Name="RepairIndexesButton" Content="Reparar índices (sem perda de dados)"
                                            Style="{StaticResource FlatButton}" Height="42" Margin="0,10,0,0"
                                            Click="RepairIndexesButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- [PRIMÁRIO p/ corrupção LÓGICA] Corrigir integridade (remover registros órfãos) -->
                            <Border x:Name="ConstraintFixPanel" Visibility="Collapsed" Margin="0,8,0,0"
                                    Background="{DynamicResource WarnBackBrush}" BorderBrush="{DynamicResource WarnLineBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="⚠ INTEGRIDADE LÓGICA: REGISTROS ÓRFÃOS"
                                               FontWeight="Bold" Foreground="{DynamicResource WarnForeBrush}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ConstraintFixText" Margin="0,8,0,0" Foreground="{DynamicResource WarnForeBrush}" TextWrapping="Wrap"
                                               Text="Há linhas cuja chave estrangeira aponta para um registro inexistente (o DBCC CHECKDB não detecta isso). A correção REMOVE essas linhas órfãs para restaurar a integridade — operação destrutiva, com backup de segurança antes. Para preservar 100% dos registros, prefira restaurar de backup." />
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="RECUPERAÇÃO DE REGISTROS-PAI (OPCIONAL)" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource WarnForeBrush}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ChooseRecoveryBakFixButton" Content="📁 Escolher .bak…"
                                                    Style="{StaticResource SecondaryButton}" Height="34" Click="ChooseRecoveryBackupButton_Click" />
                                            <Button x:Name="ClearRecoveryBakFixButton" Content="↺ Automático"
                                                    Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Click="ClearRecoveryBackupButton_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="RecoveryBakFixText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource WarnForeBrush}"
                                                   Text="Automático: usa o backup FULL mais recente do histórico. Escolha um .bak se o backup estiver em outra mídia (o SQL Server precisa conseguir lê-lo)." />
                                    </StackPanel>
                                    <CheckBox x:Name="ConstraintFixConfirmCheck" Margin="0,12,0,0" Foreground="{DynamicResource WarnForeBrush}"
                                              Content="Entendo e autorizo a remoção dos registros órfãos."
                                              Checked="ConstraintFixConfirmCheck_Changed" Unchecked="ConstraintFixConfirmCheck_Changed" />
                                    <Button x:Name="ConstraintFixButton" Content="Corrigir integridade (remover registros órfãos)"
                                            Style="{StaticResource DangerButton}" Height="40" Margin="0,12,0,0"
                                            IsEnabled="False" Click="ConstraintFixButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- [PRIMÁRIO p/ OFFLINE/RESTORING/etc.] Reparo seguro -->
                            <StackPanel x:Name="SafeRepairPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                <Button x:Name="SafeRepairButton" Content="Reparar (modo seguro, sem perda de dados)"
                                        Style="{StaticResource FlatButton}" Height="40" Click="SafeRepairButton_Click" />
                                <TextBlock Text="Tentaremos primeiro a abordagem mais segura: religar / recuperar e, se necessário, DBCC CHECKDB com REPAIR_REBUILD."
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Ver script planejado (dry-run) -->
                            <Button x:Name="ViewScriptButton" Visibility="Collapsed" Content="Ver script planejado (não executa nada)"
                                    Style="{StaticResource SecondaryButton}" Height="40" Margin="0,10,0,0"
                                    Click="ViewScriptButton_Click" />

                            <!-- [PRIMÁRIO p/ corrupção de DADOS] Restaurar de backup -->
                            <StackPanel x:Name="RestorePanel" Visibility="Collapsed" Margin="0,18,0,0">
                                <TextBlock Text="RESTAURAR DE BACKUP" Style="{StaticResource FieldLabel}" />
                                <TextBlock Text="Caminho correto quando os arquivos de DADOS estão corrompidos: substitui o banco pelos dados íntegros de um backup."
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                <Button x:Name="ChooseBackupButton" Content="Escolher arquivo .bak..."
                                        Style="{StaticResource SecondaryButton}" Height="42" Click="ChooseBackupButton_Click" />
                                <TextBlock x:Name="BackupSourceText" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                                <ListBox x:Name="BackupSetsList" Height="120" Margin="0,8,0,0"
                                         Background="{DynamicResource CardBrush}"
                                         DisplayMemberPath="Display" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" />
                                <CheckBox x:Name="RestoreReplaceCheck" Content="Substituir o banco existente (REPLACE)"
                                          IsChecked="True" Margin="0,10,0,0" />
                                <Button x:Name="RestoreButton" Content="Restaurar o backup selecionado"
                                        Style="{StaticResource FlatButton}" Height="46" Margin="0,12,0,0"
                                        Click="RestoreButton_Click" />
                                <Button x:Name="RestoreChainButton" Content="Restaurar cadeia completa (mais recente)"
                                        Style="{StaticResource FlatButton}" Height="46" Margin="0,8,0,0"
                                        Click="RestoreChainButton_Click" />
                                <TextBlock Text="A cadeia completa monta automaticamente FULL → diferencial → logs (com tail-log), validando a continuidade antes de executar."
                                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

                                <!-- Opções avançadas de restauração (progressive disclosure) -->
                                <Expander Header="Mais opções de restauração (avançado)" Margin="0,14,0,0"
                                          Foreground="{DynamicResource PrimaryDarkBrush}" FontWeight="SemiBold">
                                    <StackPanel Margin="0,10,0,0">
                                        <!-- Ponto-no-tempo (STOPAT) opcional para a cadeia e o STANDBY -->
                                        <CheckBox x:Name="PointInTimeCheck" Content="Restaurar até um ponto no tempo (STOPAT)"
                                                  Margin="0,0,0,2" Checked="PointInTimeCheck_Changed" Unchecked="PointInTimeCheck_Changed" />
                                        <StackPanel x:Name="PointInTimeRow" Orientation="Horizontal" Visibility="Collapsed" Margin="0,4,0,8">
                                            <DatePicker x:Name="StopAtDate" Width="150" />
                                            <TextBox x:Name="StopAtTime" Width="96" Margin="6,0,0,0" Height="28" VerticalContentAlignment="Center"
                                                     Text="23:59:59" ToolTip="Hora no formato HH:mm:ss"
                                                     Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                                     BorderBrush="{DynamicResource LineBrush}" />
                                        </StackPanel>

                                        <Button x:Name="TestRestoreButton" Content="Testar backup (restauração de teste, não altera o banco)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,2,0,0"
                                                Click="TestRestoreButton_Click" />
                                        <Button x:Name="VerifyBackupsButton" Content="Verificar saúde dos backups (VERIFYONLY)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="VerifyBackupsButton_Click" />
                                        <Button x:Name="RestoreCopyButton" Content="Recuperar para cópia (salvamento, não altera o original)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="RestoreCopyButton_Click" />
                                        <Button x:Name="RestoreStandbyButton" Content="Restaurar em STANDBY (somente leitura, para inspecionar)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="RestoreStandbyButton_Click" />
                                        <Button x:Name="FinalizeRecoveryButton" Content="Finalizar recuperação (sair do STANDBY)"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,6,0,0"
                                                Click="FinalizeRecoveryButton_Click" />

                                        <!-- Restauração apenas das páginas afetadas -->
                                        <TextBlock Text="RESTAURAR APENAS AS PÁGINAS AFETADAS" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
                                        <TextBlock Text="Quando poucas páginas estão corrompidas, recupere só elas (preserva o resto). Exige modelo FULL/BULK e a cadeia de backups. Formato fileId:pageId separadas por vírgula."
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBox x:Name="PagesBox" Height="30" VerticalContentAlignment="Center"
                                                 Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                                 BorderBrush="{DynamicResource LineBrush}" />
                                        <Button x:Name="RestorePagesButton" Content="Restaurar apenas estas páginas"
                                                Style="{StaticResource SecondaryButton}" Height="40" Margin="0,8,0,0"
                                                Click="RestorePagesButton_Click" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Assistente de salvamento: copiar dados da cópia recuperada de volta ao banco vivo -->
                            <Border x:Name="SalvagePanel" Visibility="Collapsed" Margin="0,16,0,0"
                                    Background="{DynamicResource OkBackBrush}" BorderBrush="{DynamicResource OkForeBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="ASSISTENTE DE SALVAMENTO" Style="{StaticResource FieldLabel}" />
                                    <TextBlock x:Name="SalvageHintText" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,8"
                                               Foreground="{DynamicResource OkForeBrush}"
                                               Text="Cópia recuperada disponível. Selecione uma tabela e traga de volta ao banco vivo as linhas que faltam (por chave primária, sem duplicar)." />
                                    <ComboBox x:Name="SalvageTableCombo" Height="28" />
                                    <Button x:Name="SalvageButton" Content="Copiar linhas faltantes desta tabela"
                                            Style="{StaticResource FlatButton}" Height="40" Margin="0,8,0,0"
                                            Click="SalvageButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Reparo com perda de dados (confirmação) -->
                            <Border x:Name="DataLossPanel" Visibility="Collapsed" Margin="0,18,0,0"
                                    Background="{DynamicResource ProblemBackBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="⚠ ATENÇÃO: REPARO COM POSSÍVEL PERDA DE DADOS"
                                               FontWeight="Bold" Foreground="{DynamicResource DangerDarkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource DangerDarkBrush}" TextWrapping="Wrap"
                                               Text="O reparo seguro não foi suficiente. A próxima etapa usa DBCC CHECKDB com REPAIR_ALLOW_DATA_LOSS, que pode DESCARTAR dados corrompidos para tornar o banco consistente. Antes de executar, a ferramenta preserva automaticamente o que for possível: as transações mais recentes (tail-log) e um backup de segurança — se houver cadeia de backups, os dados descartados podem ser recuperados depois. Ao final, um backup FULL novo é criado (a cadeia antiga deixa de valer). Se existir backup íntegro, RESTAURAR (abaixo) preserva 100% dos dados." />
                                    <Button x:Name="SimulateRepairButton" Content="🔬  Simular antes (pré-visualizar a perda, sem tocar no banco)"
                                            Style="{StaticResource SecondaryButton}" Height="42" Margin="0,12,0,0"
                                            Click="SimulateRepairButton_Click" />
                                    <TextBlock x:Name="SimulateResultText" Visibility="Collapsed" Margin="0,8,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DangerDarkBrush}" TextWrapping="Wrap" />
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="RECUPERAÇÃO DE REGISTROS-PAI (OPCIONAL)" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource DangerDarkBrush}" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="ChooseRecoveryBakLossButton" Content="📁 Escolher .bak…"
                                                    Style="{StaticResource SecondaryButton}" Height="34" Click="ChooseRecoveryBackupButton_Click" />
                                            <Button x:Name="ClearRecoveryBakLossButton" Content="↺ Automático"
                                                    Style="{StaticResource SecondaryButton}" Height="34" Margin="8,0,0,0" Click="ClearRecoveryBackupButton_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="RecoveryBakLossText" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource DangerDarkBrush}"
                                                   Text="Automático: usa o backup FULL mais recente do histórico. Escolha um .bak se o backup estiver em outra mídia (o SQL Server precisa conseguir lê-lo)." />
                                    </StackPanel>
                                    <CheckBox x:Name="DataLossConfirmCheck" Margin="0,12,0,0" Foreground="{DynamicResource DangerDarkBrush}"
                                              Content="Estou ciente e autorizo o reparo com possível perda de dados."
                                              Checked="DataLossConfirmCheck_Changed" Unchecked="DataLossConfirmCheck_Changed" />
                                    <Button x:Name="DataLossRepairButton" Content="Executar reparo COM perda de dados"
                                            Style="{StaticResource DangerButton}" Height="42" Margin="0,12,0,0"
                                            IsEnabled="False" Click="DataLossRepairButton_Click" />
                                </StackPanel>
                            </Border>

                            <!-- Resultado -->
                            <Border x:Name="ResultPanel" Visibility="Collapsed" Margin="0,18,0,0"
                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                <TextBlock x:Name="ResultText" TextWrapping="Wrap" />
                            </Border>

                            <!-- Último recurso: reconstruir o log de transações -->
                            <Border x:Name="LogRebuildPanel" Visibility="Collapsed" Margin="0,18,0,0"
                                    Background="{DynamicResource DangerPanelBackBrush}" BorderBrush="{DynamicResource DangerBrush}"
                                    BorderThickness="2" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="⛔ ÚLTIMO RECURSO: RECONSTRUIR O LOG DE TRANSAÇÕES"
                                               FontWeight="Bold" Foreground="{DynamicResource DangerDarkBrush}" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource DangerDarkBrush}" TextWrapping="Wrap"
                                               Text="Indicado quando o problema está no LOG de transações (ex.: RECOVERY_PENDING ou SUSPECT por log corrompido/ausente) e o reparo não resolveu. Esta operação desanexa o banco, REMOVE o arquivo de log (.ldf) e o recria (FOR ATTACH_REBUILD_LOG) para forçar o retorno a ONLINE. Pode haver PERDA DE DADOS e inconsistências lógicas." />
                                    <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource DangerDarkBrush}" TextWrapping="Wrap" FontSize="11"
                                               Text="Requer que os arquivos do banco estejam acessíveis nesta máquina (servidor local) e que a aplicação tenha permissão na pasta de dados. O log antigo é preservado com a extensão .corrupt_AAAAMMDDHHMMSS." />
                                    <CheckBox x:Name="LogRebuildConfirmCheck" Margin="0,12,0,0" Foreground="{DynamicResource DangerDarkBrush}"
                                              Content="Entendo os riscos e autorizo reconstruir o log."
                                              Checked="LogRebuildConfirmCheck_Changed" Unchecked="LogRebuildConfirmCheck_Changed" />
                                    <Button x:Name="LogRebuildButton" Content="Reconstruir log (recriar .ldf)"
                                            Style="{StaticResource DangerButton}" Height="42" Margin="0,12,0,0"
                                            IsEnabled="False" Click="LogRebuildButton_Click" />
                                </StackPanel>
                            </Border>
                            </StackPanel>
                        </Grid>

                        <ProgressBar x:Name="RepairBusyBar" IsIndeterminate="True" Height="5" Margin="0,16,0,0"
                                     Visibility="Collapsed" Foreground="{DynamicResource PrimaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Splitter ===== -->
        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- ===== Log ===== -->
        <Border Grid.Row="3" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource LogHeaderBackBrush}" CornerRadius="6,6,0,0" Padding="12,8">
                    <Grid>
                        <TextBlock Text="Registro de operações" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryDarkBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="ExportReportButton" Content="Exportar relatório" Style="{StaticResource SecondaryButton}"
                                    Padding="10,3" FontSize="12" Margin="0,0,8,0" Click="ExportReportButton_Click" />
                            <Button x:Name="ClearLogButton" Content="Limpar"
                                    Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="12"
                                    Click="ClearLogButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="LogList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="2,1" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding TimestampText}" FontFamily="Consolas"
                                           FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Message}" FontFamily="Consolas" FontSize="12"
                                           TextWrapping="Wrap" Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="4" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="12" VerticalAlignment="Center" Text="Pronto." />
                <TextBlock x:Name="LogPathText" Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
