<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RestoreDB.Domain\RestoreDB.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- O SqlClient 7.1.1 traz o System.Security.Cryptography.Pkcs 9.0.18, com vulnerabilidades
         conhecidas (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Fixado numa versão corrigida; quem
         referencia este projeto herda a mesma versão. Pode sair quando o SqlClient trouxer uma corrigida. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RestoreDB.Tests" />
    <InternalsVisibleTo Include="RestoreDB.IntegrationTests" />
  </ItemGroup>

</Project>
